.card {
  position: relative;
  box-sizing: border-box;
  width: 120rpx;
  height: 168rpx;
  border-radius: 14rpx;
  overflow: hidden;
  background: #222;
  border: 2rpx solid rgba(255, 255, 255, 0.4);
  box-shadow: 0 8rpx 16rpx rgba(0, 0, 0, 0.45), inset 0 0 0 1rpx rgba(0, 0, 0, 0.3);
  transition: transform 0.18s ease-out;
}
.card.size-small { width: 96rpx; height: 134rpx; border-radius: 12rpx; }
.card.size-large { width: 244rpx; height: 340rpx; border-radius: 22rpx; border-width: 3rpx; }

.card.deal { animation: deal 0.42s cubic-bezier(0.2, 0.9, 0.3, 1.2); }
@keyframes deal {
  0% { opacity: 0; transform: translateY(-40rpx) rotate(-6deg) scale(0.8); }
  100% { opacity: 1; transform: none; }
}

.card.selected { transform: translateY(-10rpx); border-color: var(--gold-hi); }
.card.affordable {
  border-color: #b9ffd0;
  animation: glow 1.6s ease-in-out infinite;
}
@keyframes glow {
  0%, 100% { box-shadow: 0 0 0 2rpx rgba(111, 227, 154, 0.9), 0 0 10rpx rgba(111, 227, 154, 0.5), 0 8rpx 16rpx rgba(0, 0, 0, 0.45); }
  50% { box-shadow: 0 0 0 4rpx rgba(111, 227, 154, 1), 0 0 26rpx rgba(111, 227, 154, 0.8), 0 8rpx 16rpx rgba(0, 0, 0, 0.45); }
}

.card.empty {
  background: rgba(255, 255, 255, 0.03);
  border: 2rpx dashed rgba(255, 255, 255, 0.14);
  box-shadow: none;
  display: flex;
  align-items: center;
  justify-content: center;
}
.empty-mark {
  width: 26rpx;
  height: 26rpx;
  transform: rotate(45deg);
  border: 2rpx solid rgba(255, 255, 255, 0.12);
}

.art { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }

.band {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 44rpx;
  padding: 0 6rpx 0 10rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.92), rgba(255, 255, 255, 0.68));
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.12);
}
.size-small .band { height: 34rpx; padding: 0 4rpx 0 8rpx; }
.size-large .band { height: 88rpx; padding: 0 12rpx 0 22rpx; }

.pts { font-size: 36rpx; line-height: 1; color: #1b2032; text-shadow: 0 1rpx 0 #fff; }
.size-small .pts { font-size: 26rpx; }
.size-large .pts { font-size: 68rpx; }

.gem { width: 36rpx; height: 36rpx; filter: drop-shadow(0 2rpx 2rpx rgba(0, 0, 0, 0.35)); }
.size-small .gem { width: 26rpx; height: 26rpx; }
.size-large .gem { width: 74rpx; height: 74rpx; }

/* 4 种成本也要放得下：4 × (27 + 3) + 7 < 168 - 44 */
.cost {
  position: absolute;
  left: 7rpx;
  bottom: 7rpx;
  display: flex;
  flex-direction: column-reverse;
}
.size-large .cost { left: 16rpx; bottom: 16rpx; }

.pip {
  box-sizing: border-box;
  width: 27rpx;
  height: 27rpx;
  line-height: 23rpx;
  margin-top: 3rpx;
  border-radius: 50%;
  font-size: 20rpx;
  text-align: center;
  border: 2rpx solid rgba(255, 255, 255, 0.9);
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.5);
}
.size-small .pip { width: 21rpx; height: 21rpx; line-height: 18rpx; font-size: 15rpx; margin-top: 2rpx; border-width: 1.5rpx; }
.size-large .pip { width: 52rpx; height: 52rpx; line-height: 47rpx; font-size: 32rpx; margin-top: 6rpx; border-width: 3rpx; }

.buy-tag {
  position: absolute;
  right: 6rpx;
  bottom: 6rpx;
  padding: 0 10rpx;
  height: 30rpx;
  line-height: 30rpx;
  border-radius: 15rpx;
  font-size: 18rpx;
  font-weight: 700;
  color: #0d3a1f;
  background: linear-gradient(180deg, #c8ffd9, #6fe39a);
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.4);
}
.buy-tag.gold { color: #3a2600; background: linear-gradient(180deg, #fff1b8, #f5b80a); }
