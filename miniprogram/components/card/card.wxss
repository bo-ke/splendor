.card {
  position: relative;
  box-sizing: border-box;
  width: 120rpx;
  height: 168rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: #2a1c12;
  border: 3rpx solid #b48a44;
  box-shadow: 0 8rpx 16rpx rgba(0, 0, 0, 0.55), 0 0 0 1rpx rgba(0, 0, 0, 0.6);
  transition: transform 0.18s ease-out;
}
.card.size-small { width: 96rpx; height: 134rpx; border-radius: 12rpx; }
.card.size-large { width: 244rpx; height: 340rpx; border-radius: 22rpx; border-width: 3rpx; }

.card.deal { animation: deal 0.42s cubic-bezier(0.2, 0.9, 0.3, 1.2); }
@keyframes deal {
  0% { opacity: 0; transform: translateY(-40rpx) rotate(-6deg) scale(0.8); }
  100% { opacity: 1; transform: none; }
}

.card.selected { transform: translateY(-10rpx); border-color: #ffe1a0; }
.card.affordable {
  border-color: #b9ffd0;
  animation: glow 1.6s ease-in-out infinite;
}
@keyframes glow {
  0%, 100% { box-shadow: 0 0 0 2rpx rgba(111, 227, 154, 0.9), 0 0 10rpx rgba(111, 227, 154, 0.5), 0 8rpx 16rpx rgba(0, 0, 0, 0.45); }
  50% { box-shadow: 0 0 0 4rpx rgba(111, 227, 154, 1), 0 0 26rpx rgba(111, 227, 154, 0.8), 0 8rpx 16rpx rgba(0, 0, 0, 0.45); }
}

.card.empty {
  background: rgba(255, 255, 255, 0.03);
  border: 2rpx dashed rgba(255, 255, 255, 0.14);
  box-shadow: none;
  display: flex;
  align-items: center;
  justify-content: center;
}
.empty-mark {
  width: 26rpx;
  height: 26rpx;
  transform: rotate(45deg);
  border: 2rpx solid rgba(255, 255, 255, 0.12);
}

.art { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.art.flip { transform: scaleX(-1); }
/* 内侧暗金细框，像画框 */
.frame {
  position: absolute;
  left: 4rpx;
  top: 4rpx;
  right: 4rpx;
  bottom: 4rpx;
  border-radius: 8rpx;
  border: 1rpx solid rgba(255, 226, 160, 0.45);
  box-shadow: inset 0 0 12rpx rgba(0, 0, 0, 0.55);
}
.size-large .frame { left: 8rpx; top: 8rpx; right: 8rpx; bottom: 8rpx; border-width: 2rpx; }

.band {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 44rpx;
  padding: 0 6rpx 0 10rpx;
  /* 羊皮纸标签 */
  background: linear-gradient(180deg, rgba(248, 236, 208, 0.94), rgba(222, 198, 150, 0.86));
  border-bottom: 2rpx solid rgba(120, 80, 30, 0.55);
  box-shadow: 0 3rpx 6rpx rgba(0, 0, 0, 0.35);
}
.size-small .band { height: 34rpx; padding: 0 4rpx 0 8rpx; }
.size-large .band { height: 88rpx; padding: 0 12rpx 0 22rpx; }

.pts { font-size: 36rpx; line-height: 1; color: #3a2414; text-shadow: 0 1rpx 0 rgba(255, 248, 230, 0.9); }
.size-small .pts { font-size: 26rpx; }
.size-large .pts { font-size: 68rpx; }

.ore { width: 40rpx; height: 40rpx; filter: drop-shadow(0 2rpx 2rpx rgba(0, 0, 0, 0.45)); }
.size-small .ore { width: 30rpx; height: 30rpx; }
.size-large .ore { width: 80rpx; height: 80rpx; }

/* 4 种成本也要放得下：4 × (26 + 2) + 6 < 168 - 44 - 边框 6 */
.cost {
  position: absolute;
  left: 7rpx;
  bottom: 6rpx;
  display: flex;
  flex-direction: column-reverse;
}
.size-large .cost { left: 16rpx; bottom: 16rpx; }

.pip {
  box-sizing: border-box;
  width: 26rpx;
  height: 26rpx;
  line-height: 22rpx;
  margin-top: 2rpx;
  border-radius: 50%;
  font-size: 20rpx;
  text-align: center;
  border: 2rpx solid rgba(255, 236, 200, 0.95);
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.6);
}
.size-small .pip { width: 21rpx; height: 21rpx; line-height: 18rpx; font-size: 15rpx; margin-top: 2rpx; border-width: 1.5rpx; }
.size-large .pip { width: 52rpx; height: 52rpx; line-height: 47rpx; font-size: 32rpx; margin-top: 6rpx; border-width: 3rpx; }

.buy-tag {
  position: absolute;
  right: 6rpx;
  bottom: 6rpx;
  padding: 0 10rpx;
  height: 30rpx;
  line-height: 30rpx;
  border-radius: 15rpx;
  font-size: 18rpx;
  font-weight: 700;
  color: #0d3a1f;
  background: linear-gradient(180deg, #c8ffd9, #6fe39a);
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.4);
}
.buy-tag.gold { color: #3a2600; background: linear-gradient(180deg, #fff1b8, #f5b80a); }
