<view wx:if="{{card}}" class="card size-{{size}} {{selected ? 'selected' : ''}} {{highlight && card.affordable ? 'affordable' : ''}} {{deal ? 'deal' : ''}}">
  <image class="art {{card.flip ? 'flip' : ''}}" src="/assets/art/cards/{{card.bonus}}{{card.tier}}.jpg" mode="aspectFill" />
  <view class="frame"></view>
  <view class="band">
    <text class="pts num">{{card.points ? card.points : ''}}</text>
    <image class="ore" src="/assets/art/ores/{{card.bonus}}.png" mode="aspectFit" />
  </view>
  <view class="cost">
    <view wx:for="{{card.cost}}" wx:key="color" class="pip num gem-text gem-bg-{{item.color}}">{{item.n}}</view>
  </view>
  <view wx:if="{{highlight && card.affordable}}" class="buy-tag {{card.goldNeeded ? 'gold' : ''}}">{{card.tag}}</view>
</view>
<view wx:else class="card empty size-{{size}}">
  <view class="empty-mark"></view>
</view>
