<view wx:if="{{card}}" class="card size-{{size}} {{selected ? 'selected' : ''}} {{highlight && card.affordable ? 'affordable' : ''}} {{deal ? 'deal' : ''}}">
  <image class="art" src="/assets/cards/{{card.bonus}}.svg" mode="scaleToFill" />
  <view class="band">
    <text class="pts num">{{card.points ? card.points : ''}}</text>
    <image class="gem" src="/assets/gems/{{card.bonus}}.svg" mode="aspectFit" />
  </view>
  <view class="cost">
    <view wx:for="{{card.cost}}" wx:key="color" class="pip num gem-text gem-bg-{{item.color}}">{{item.n}}</view>
  </view>
  <view wx:if="{{highlight && card.affordable}}" class="buy-tag {{card.goldNeeded ? 'gold' : ''}}">{{card.goldNeeded ? '金×' + card.goldNeeded : '可买'}}</view>
</view>
<view wx:else class="card empty size-{{size}}">
  <view class="empty-mark"></view>
</view>
