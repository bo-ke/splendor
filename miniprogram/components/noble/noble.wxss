.noble {
  position: relative;
  box-sizing: border-box;
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  background: linear-gradient(160deg, #f1dfb5, #b8925a);
  border: 3rpx solid rgba(255, 255, 255, 0.25);
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.3);
}
.noble.size-small { width: 72rpx; height: 72rpx; border-radius: 8rpx; }

.pts {
  position: absolute;
  right: 12rpx;
  top: 6rpx;
  font-size: 36rpx;
  font-weight: 800;
  color: #3a2a10;
}
.size-small .pts { font-size: 24rpx; right: 6rpx; top: 2rpx; }

.req {
  position: absolute;
  left: 8rpx;
  top: 8rpx;
  bottom: 8rpx;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}
.size-small .req { left: 4rpx; top: 4rpx; bottom: 4rpx; }

/* 3 种要求也要放得下：3 × (30 + 4) < 120 - 16 */
.bar {
  box-sizing: border-box;
  width: 30rpx;
  height: 30rpx;
  line-height: 26rpx;
  margin-top: 4rpx;
  border-radius: 6rpx;
  font-size: 20rpx;
  font-weight: 700;
  text-align: center;
  border: 2rpx solid rgba(0, 0, 0, 0.3);
}
.size-small .bar { width: 18rpx; height: 18rpx; line-height: 15rpx; font-size: 13rpx; margin-top: 2rpx; }
