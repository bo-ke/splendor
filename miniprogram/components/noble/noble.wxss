.noble {
  position: relative;
  box-sizing: border-box;
  width: 112rpx;
  height: 112rpx;
  border-radius: 14rpx;
  overflow: hidden;
  background: #2a1c12;
  border: 3rpx solid #b48a44;
  box-shadow: 0 8rpx 16rpx rgba(0, 0, 0, 0.55);
}
.noble.size-small { width: 64rpx; height: 64rpx; border-radius: 10rpx; }

.art { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.frame { position: absolute; left: 3rpx; top: 3rpx; right: 3rpx; bottom: 3rpx; border-radius: 8rpx; border: 1rpx solid rgba(255, 226, 160, 0.4); }

.side {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  width: 38rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 4rpx;
  /* 羊皮纸侧条 */
  background: linear-gradient(270deg, rgba(246, 232, 200, 0.92), rgba(226, 204, 158, 0.82));
  border-left: 2rpx solid rgba(120, 80, 30, 0.5);
}
.size-small .side { width: 24rpx; }

.pts { font-size: 26rpx; line-height: 26rpx; color: #3a2414; text-shadow: 0 1rpx 0 rgba(255, 248, 230, 0.8); }
.size-small .pts { font-size: 20rpx; line-height: 24rpx; }

/* 3 种要求也要放得下：(112 - 边框 4 - 上边距 4) ≥ 26 + 3 × (23 + 2) + 2 */
.req { margin-top: auto; padding-bottom: 2rpx; display: flex; flex-direction: column; align-items: center; }
.req-card {
  box-sizing: border-box;
  width: 23rpx;
  height: 23rpx;
  line-height: 20rpx;
  margin-top: 2rpx;
  border-radius: 5rpx;
  font-size: 18rpx;
  text-align: center;
  border: 1.5rpx solid rgba(255, 255, 255, 0.85);
  box-shadow: 0 1rpx 3rpx rgba(0, 0, 0, 0.45);
}
