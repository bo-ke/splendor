.noble {
  position: relative;
  box-sizing: border-box;
  width: 112rpx;
  height: 112rpx;
  border-radius: 14rpx;
  overflow: hidden;
  border: 2rpx solid rgba(255, 236, 190, 0.7);
  box-shadow: 0 8rpx 16rpx rgba(0, 0, 0, 0.45);
}
.noble.size-small { width: 64rpx; height: 64rpx; border-radius: 10rpx; }

.art { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }

.side {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 38rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 4rpx;
}
.size-small .side { width: 24rpx; }

.pts { font-size: 26rpx; line-height: 26rpx; color: #4a3008; text-shadow: 0 1rpx 0 rgba(255, 255, 255, 0.7); }
.size-small .pts { font-size: 20rpx; line-height: 24rpx; }

/* 3 种要求也要放得下：(112 - 边框 4 - 上边距 4) ≥ 26 + 3 × (23 + 2) + 2 */
.req { margin-top: auto; padding-bottom: 2rpx; display: flex; flex-direction: column; align-items: center; }
.req-card {
  box-sizing: border-box;
  width: 23rpx;
  height: 23rpx;
  line-height: 20rpx;
  margin-top: 2rpx;
  border-radius: 5rpx;
  font-size: 18rpx;
  text-align: center;
  border: 1.5rpx solid rgba(255, 255, 255, 0.85);
  box-shadow: 0 1rpx 3rpx rgba(0, 0, 0, 0.45);
}
