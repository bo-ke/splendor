<image class="wall" src="/assets/art/wall.jpg" mode="aspectFill" />
<view class="page">
  <view class="topbar">
    <view class="lang-pill" bindtap="onToggleLang">{{t.language}}</view>
  </view>
  <view class="hero">
    <view class="ores">
      <image wx:for="{{ores}}" wx:key="*this" class="ore g{{index}}" src="/assets/art/ores/{{item}}.png" mode="aspectFit" />
    </view>
    <view class="title {{t.lang === 'en' ? 'en' : ''}}">{{t.appName}}</view>
    <view wx:if="{{t.lang === 'zh'}}" class="title-en">ORE MERCHANT</view>
    <view class="sub">{{t.subtitle}}</view>
  </view>

  <view wx:if="{{hasSave}}" class="resume" hover-class="btn-hover" bindtap="onResume">
    <image class="resume-icon" src="/assets/art/backs/tier2.jpg" mode="aspectFill" />
    <view class="resume-text">
      <text class="resume-title">{{t.resume}}</text>
      <text class="resume-sub">{{t.resumeSub}}</text>
    </view>
    <text class="resume-go">›</text>
  </view>

  <view class="tabs">
    <view class="tab {{mode === 'local' ? 'on' : ''}}" data-mode="local" bindtap="onMode">{{t.local}}</view>
    <view class="tab {{mode === 'online' ? 'on' : ''}}" data-mode="online" bindtap="onMode">{{t.online}}</view>
  </view>

  <block wx:if="{{mode === 'online'}}">
    <view wx:if="{{lastRoom}}" class="resume" hover-class="btn-hover" bindtap="onBackToRoom">
      <image class="resume-icon" src="/assets/art/backs/tier3.jpg" mode="aspectFill" />
      <view class="resume-text">
        <text class="resume-title">{{t.backToRoom}}</text>
      </view>
      <text class="resume-go">›</text>
    </view>
    <view class="panel">
      <view wx:if="{{!onlineOk}}" class="tip warn">{{t.onlineOff}}</view>
      <view class="label">{{t.nick}}</view>
      <input class="field" value="{{nick}}" maxlength="12" placeholder="{{t.nickPh}}" placeholder-class="ph" bindinput="onNick" />
      <view class="btn primary start {{t.lang === 'en' ? 'en' : ''}}" hover-class="btn-hover" bindtap="onCreateRoom">{{t.createRoom}}</view>
      <view class="join-row">
        <input class="field code" type="number" value="{{joinCode}}" maxlength="6" placeholder="{{t.codePh}}" placeholder-class="ph" bindinput="onCode" />
        <view class="btn join-btn" hover-class="btn-hover" bindtap="onJoinRoom">{{t.join}}</view>
      </view>
    </view>
  </block>

  <block wx:else>
  <view class="panel">
    <view class="label">{{t.playerCount}}</view>
    <view class="seg">
      <view wx:for="{{[2, 3, 4]}}" wx:key="*this" class="seg-item {{count === item ? 'on' : ''}}" data-n="{{item}}" bindtap="onCount">
        <text class="num">{{item}}</text> {{t.people}}
      </view>
    </view>

    <view class="label gap">{{t.seats}}</view>
    <view wx:for="{{seats}}" wx:if="{{index < count}}" class="seat">
      <view class="avatar av-{{index}}">{{index + 1}}</view>
      <input class="seat-name" value="{{item.name}}" maxlength="12" placeholder="{{t.namePh}}" placeholder-class="ph" data-i="{{index}}" bindinput="onName" />
      <view class="type" data-i="{{index}}" bindtap="onToggleAI">
        <view class="type-opt {{item.isAI ? '' : 'on'}}">{{t.human}}</view>
        <view class="type-opt {{item.isAI ? 'on' : ''}}">{{t.bot}}</view>
      </view>
    </view>
    <view class="tip">{{t.hotseatTip}}</view>
  </view>

  <view class="btn primary start {{t.lang === 'en' ? 'en' : ''}}" hover-class="btn-hover" bindtap="onStart">{{t.start}}</view>
  </block>
  <view class="link" bindtap="onRules">{{t.howTo}}</view>

  <view class="credit">
    <view>{{t.credit}}</view>
    <view class="credit-sub">{{t.disclaimer}}</view>
  </view>
</view>

<view wx:if="{{showRules}}" class="mask" bindtap="onRules">
  <view class="dialog rules" catchtap="noop">
    <view class="dialog-title">{{t.howTo}}</view>
    <scroll-view scroll-y class="rules-body">
      <block wx:for="{{t.rules}}" wx:key="key">
        <view class="h">{{item.h}}</view>
        <text class="p" decode="{{false}}">{{item.p}}</text>
      </block>
    </scroll-view>
    <view class="btn primary wide" hover-class="btn-hover" bindtap="onRules">{{t.gotIt}}</view>
  </view>
</view>
