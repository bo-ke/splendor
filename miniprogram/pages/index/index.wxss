.page { padding: 40rpx 40rpx 80rpx; }

.hero { text-align: center; padding: 40rpx 0 50rpx; }
.logo { display: flex; justify-content: center; margin-bottom: 30rpx; }
.logo .g {
  width: 46rpx;
  height: 46rpx;
  margin: 0 16rpx;
  transform: rotate(45deg);
  border-radius: 8rpx;
  border: 3rpx solid rgba(0, 0, 0, 0.3);
  box-shadow: 0 6rpx 14rpx rgba(0, 0, 0, 0.35);
}
.title { font-size: 64rpx; font-weight: 800; letter-spacing: 8rpx; color: var(--accent); }
.sub { margin-top: 10rpx; color: var(--muted); font-size: 26rpx; }

.wide { display: flex; width: 100%; box-sizing: border-box; margin-top: 30rpx; height: 92rpx; border-radius: 46rpx; font-size: 32rpx; }

.section { margin-top: 40rpx; padding: 28rpx; background: var(--panel); border-radius: 20rpx; }
.label { color: var(--muted); font-size: 26rpx; margin-bottom: 20rpx; }

.seg { display: flex; background: var(--bg); border-radius: 14rpx; padding: 6rpx; }
.seg-item { flex: 1; text-align: center; padding: 18rpx 0; border-radius: 10rpx; color: var(--muted); }
.seg-item.on { background: var(--accent); color: #2a2000; font-weight: 700; }

.seat { display: flex; align-items: center; margin-bottom: 18rpx; }
.seat-no {
  width: 48rpx; height: 48rpx; line-height: 48rpx; text-align: center;
  border-radius: 50%; background: var(--panel-2); font-size: 24rpx; margin-right: 18rpx;
}
.seat-name { flex: 1; height: 76rpx; padding: 0 20rpx; border-radius: 12rpx; background: var(--bg); color: var(--text); }
.type { margin-left: 18rpx; width: 110rpx; height: 64rpx; line-height: 64rpx; text-align: center; border-radius: 32rpx; font-size: 26rpx; }
.type.human { background: var(--accent); color: #2a2000; }
.type.ai { background: var(--panel-2); color: var(--text); }
.tip { color: var(--muted); font-size: 22rpx; margin-top: 8rpx; }

.link { text-align: center; margin-top: 36rpx; color: var(--muted); text-decoration: underline; }

.mask { position: fixed; left: 0; top: 0; right: 0; bottom: 0; background: rgba(0, 0, 0, 0.6); display: flex; align-items: center; justify-content: center; z-index: 10; }
.rules { width: 640rpx; padding: 36rpx; background: var(--panel); border-radius: 24rpx; box-sizing: border-box; }
.rules-title { font-size: 36rpx; font-weight: 700; text-align: center; margin-bottom: 20rpx; }
.rules-body { max-height: 820rpx; }
.rules .h { margin-top: 20rpx; color: var(--accent); font-weight: 700; }
.rules .p { margin-top: 8rpx; line-height: 1.6; font-size: 26rpx; }
