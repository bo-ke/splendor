.page { padding: 20rpx 40rpx 80rpx; }

/* ---------------- 标题 ---------------- */
.topbar { display: flex; justify-content: flex-end; }
.lang-pill {
  height: 52rpx;
  line-height: 50rpx;
  padding: 0 22rpx;
  border-radius: 26rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--gold-hi);
  border: 2rpx solid rgba(226, 182, 90, 0.6);
  background: rgba(0, 0, 0, 0.3);
}
.hero { text-align: center; padding: 20rpx 0 44rpx; }
.ores { display: flex; justify-content: center; align-items: flex-end; height: 130rpx; }
.ore {
  width: 96rpx;
  height: 96rpx;
  margin: 0 6rpx;
  filter: drop-shadow(0 12rpx 12rpx rgba(0, 0, 0, 0.45));
  animation: float 3.2s ease-in-out infinite;
}
.ore.g1 { animation-delay: 0.3s; margin-bottom: 18rpx; }
.ore.g2 { animation-delay: 0.6s; width: 116rpx; height: 116rpx; margin-bottom: 28rpx; }
.ore.g3 { animation-delay: 0.9s; margin-bottom: 18rpx; }
.ore.g4 { animation-delay: 1.2s; }
@keyframes float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-10rpx); } }

.title {
  margin-top: 28rpx;
  font-size: 96rpx;
  font-weight: 800;
  letter-spacing: 20rpx;
  font-family: 'Songti SC', 'STSong', Georgia, serif;
  color: var(--gold);
  background: linear-gradient(180deg, #fff2c4 0%, #f2c35b 55%, #b8801c 100%);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
}
.title.en { font-size: 76rpx; letter-spacing: 4rpx; font-family: Georgia, 'Times New Roman', serif; }
.title-en { margin-top: 4rpx; font-family: Georgia, 'Times New Roman', serif; font-size: 24rpx; letter-spacing: 12rpx; color: rgba(255, 225, 160, 0.75); }
.sub { margin-top: 12rpx; color: var(--muted); font-size: 22rpx; letter-spacing: 4rpx; }

/* ---------------- 继续上局 ---------------- */
.resume {
  display: flex;
  align-items: center;
  padding: 22rpx 28rpx;
  margin-bottom: 28rpx;
  border-radius: 24rpx;
  background: linear-gradient(90deg, rgba(226, 182, 90, 0.24), rgba(74, 50, 34, 0.7));
  border: 2rpx solid rgba(226, 182, 90, 0.6);
}
.resume-icon { width: 54rpx; height: 76rpx; border-radius: 8rpx; box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.4); }
.resume-text { flex: 1; display: flex; flex-direction: column; margin-left: 22rpx; }
.resume-title { font-size: 32rpx; font-weight: 700; color: var(--gold-hi); }
.resume-sub { font-size: 22rpx; color: var(--muted); margin-top: 4rpx; }
.resume-go { font-size: 48rpx; color: var(--gold); }

/* ---------------- 设置面板 ---------------- */
.panel {
  padding: 30rpx 28rpx 24rpx;
  border-radius: 28rpx;
  background: linear-gradient(180deg, rgba(74, 50, 34, 0.9), rgba(38, 25, 18, 0.94));
  border: 2rpx solid rgba(180, 138, 68, 0.45);
  box-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.45);
}
.label { color: var(--muted); font-size: 24rpx; margin-bottom: 18rpx; letter-spacing: 2rpx; }
.label.gap { margin-top: 36rpx; }

.seg { display: flex; padding: 6rpx; border-radius: 18rpx; background: rgba(0, 0, 0, 0.3); }
.seg-item { flex: 1; text-align: center; padding: 16rpx 0; border-radius: 14rpx; color: var(--muted); font-size: 26rpx; transition: all 0.15s; }
.seg-item .num { font-size: 34rpx; }
.seg-item.on {
  color: #3a2600;
  font-weight: 700;
  background: linear-gradient(180deg, var(--gold-hi), var(--gold));
  box-shadow: 0 4rpx 12rpx rgba(242, 195, 91, 0.35);
}

.seat { display: flex; align-items: center; margin-bottom: 18rpx; }
.seat .avatar { width: 56rpx; height: 56rpx; font-family: Georgia, serif; }
.seat-name {
  flex: 1;
  min-width: 0;
  width: 0;
  height: 80rpx;
  margin: 0 18rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  background: rgba(0, 0, 0, 0.3);
  border: 1rpx solid var(--line);
  color: var(--text);
  font-size: 28rpx;
}
.ph { color: rgba(255, 255, 255, 0.25); }
.type { display: flex; padding: 4rpx; border-radius: 30rpx; background: rgba(0, 0, 0, 0.3); border: 1rpx solid var(--line); }
.type-opt { min-width: 72rpx; padding: 0 14rpx; box-sizing: border-box; height: 56rpx; line-height: 56rpx; text-align: center; white-space: nowrap; border-radius: 28rpx; font-size: 24rpx; color: var(--muted); }
.type-opt.on { color: #3a2600; font-weight: 700; background: linear-gradient(180deg, var(--gold-hi), var(--gold)); }
.tip { color: rgba(154, 166, 194, 0.75); font-size: 22rpx; margin-top: 6rpx; line-height: 1.5; }

.start.en { letter-spacing: 2rpx; }
.start { display: flex; width: 100%; height: 100rpx; margin-top: 40rpx; border-radius: 50rpx; font-size: 34rpx; letter-spacing: 8rpx; }
.credit { margin-top: 56rpx; text-align: center; font-size: 22rpx; line-height: 1.6; color: rgba(181, 161, 132, 0.75); }
.credit-sub { font-size: 20rpx; color: rgba(181, 161, 132, 0.5); }
.link { text-align: center; margin-top: 34rpx; color: var(--muted); font-size: 26rpx; }

/* ---------------- 规则 ---------------- */
.rules-body { max-height: 820rpx; margin-top: 16rpx; }
.rules .h { margin-top: 26rpx; color: var(--gold-hi); font-weight: 700; font-size: 28rpx; }
.rules .p { display: block; margin-top: 8rpx; line-height: 1.65; font-size: 26rpx; color: var(--text); }
.rules .em { color: var(--gold); font-weight: 700; }
.wide { display: flex; width: 100%; height: 88rpx; margin-top: 28rpx; }

/* ---------------- 模式切换 / 联机 ---------------- */
.tabs { display: flex; margin-bottom: 24rpx; padding: 6rpx; border-radius: 22rpx; background: rgba(0, 0, 0, 0.35); border: 1rpx solid var(--line); }
.tab { flex: 1; text-align: center; padding: 18rpx 0; border-radius: 18rpx; font-size: 28rpx; color: var(--muted); }
.tab.on { color: #3a2600; font-weight: 700; background: linear-gradient(180deg, var(--gold-hi), var(--gold)); box-shadow: 0 4rpx 12rpx rgba(226, 182, 90, 0.35); }
.field {
  box-sizing: border-box;
  width: 100%;
  height: 84rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  background: rgba(0, 0, 0, 0.3);
  border: 1rpx solid var(--line);
  color: var(--text);
  font-size: 28rpx;
}
.join-row { display: flex; align-items: center; margin-top: 28rpx; }
.field.code { flex: 1; min-width: 0; width: 0; letter-spacing: 6rpx; }
.join-btn { margin-left: 16rpx; height: 84rpx; padding: 0 40rpx; border-radius: 42rpx; }
.tip.warn { color: #ffb4aa; margin: 0 0 18rpx; }
