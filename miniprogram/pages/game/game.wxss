.page { padding: 16rpx 20rpx 0; }

/* ======================= 分数（皇冠 + 数字） ======================= */
.score { display: flex; align-items: center; flex-shrink: 0; }
.score .crown { width: 28rpx; height: 28rpx; margin-right: 4rpx; }
.score .num { font-size: 34rpx; color: var(--gold-hi); text-shadow: 0 2rpx 6rpx rgba(226, 182, 90, 0.35); }
.score.big .crown { width: 36rpx; height: 36rpx; }
.score.big .num { font-size: 48rpx; }

.avatar.big { width: 64rpx; height: 64rpx; font-size: 30rpx; }

/* ======================= 对手 ======================= */
.opps { display: flex; }
.opp {
  flex: 1;
  min-width: 0;
  margin-left: 12rpx;
  padding: 12rpx 12rpx 10rpx;
  border-radius: 18rpx;
  background: linear-gradient(180deg, rgba(74, 50, 34, 0.88), rgba(42, 28, 20, 0.92));
  border: 2rpx solid rgba(180, 138, 68, 0.35);
  transition: border-color 0.2s;
}
.opp:first-child { margin-left: 0; }
.opp.cur {
  border-color: rgba(226, 182, 90, 0.8);
  background: linear-gradient(180deg, rgba(226, 182, 90, 0.16), rgba(226, 182, 90, 0.04));
  box-shadow: 0 0 20rpx rgba(226, 182, 90, 0.25);
}
.opp-head { display: flex; align-items: center; }
.opp-head .avatar { width: 44rpx; height: 44rpx; font-size: 22rpx; }
.opp-id { flex: 1; min-width: 0; margin: 0 8rpx; display: flex; flex-direction: column; }
.opp-name { font-size: 24rpx; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.opp-sub { font-size: 18rpx; color: var(--muted); }
.opp-sub.live { color: var(--gold); }

.opp-gems { display: flex; justify-content: space-between; margin-top: 8rpx; }
.mini { display: flex; flex-direction: column; align-items: center; width: 30rpx; }
.mini-card {
  box-sizing: border-box;
  width: 28rpx;
  height: 34rpx;
  line-height: 31rpx;
  border-radius: 6rpx;
  text-align: center;
  font-size: 20rpx;
  border: 1.5rpx solid rgba(255, 255, 255, 0.55);
}
.mini-card.zero { opacity: 0.35; }
.mini-gold { width: 30rpx; height: 34rpx; }
.mini-tok { margin-top: 2rpx; font-size: 20rpx; color: var(--text); }
.mini-tok.zero { color: rgba(255, 255, 255, 0.25); }

/* ======================= 最近动作 ======================= */
.ribbon {
  display: flex;
  align-items: center;
  height: 52rpx;
  margin: 12rpx 0;
  padding: 0 8rpx 0 6rpx;
  border-radius: 26rpx;
  background: rgba(0, 0, 0, 0.22);
  border: 1rpx solid var(--line);
  font-size: 22rpx;
}
.round-pill {
  flex-shrink: 0;
  height: 40rpx;
  line-height: 40rpx;
  padding: 0 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  color: #3a2600;
  background: linear-gradient(180deg, var(--gold-hi), var(--gold));
}
.last-pill {
  flex-shrink: 0;
  margin-left: 8rpx;
  padding: 0 12rpx;
  height: 36rpx;
  line-height: 36rpx;
  border-radius: 18rpx;
  font-size: 20rpx;
  color: #fff;
  background: var(--danger);
  animation: blink 1.4s ease-in-out infinite;
}
@keyframes blink { 50% { opacity: 0.55; } }
.ribbon-text { flex: 1; min-width: 0; margin-left: 14rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: var(--text); }
.ribbon-more { flex-shrink: 0; margin-left: 10rpx; color: var(--muted); }

/* ======================= 牌桌 ======================= */
.table {
  position: relative;
  overflow: hidden;
  padding: 26rpx 20rpx 12rpx;
  border-radius: 24rpx;
  background: #1f3a2c;
  box-shadow: 0 14rpx 34rpx rgba(0, 0, 0, 0.55);
}
/* 胡桃木桌沿 + 墨绿呢布（图片铺底） */
.table-bg { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.table .nobles, .table .tier { position: relative; }
.nobles { display: flex; justify-content: center; margin-bottom: 14rpx; }
.nobles .noble-wrap { margin: 0 8rpx; }

.tier { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx; padding: 0 2rpx; }
.slot { flex-shrink: 0; }

.deck {
  position: relative;
  flex-shrink: 0;
  box-sizing: border-box;
  width: 88rpx;
  height: 168rpx;
  border-radius: 14rpx;
  overflow: hidden;
  border: 3rpx solid #b48a44;
  box-shadow: 0 6rpx 0 -2rpx #3a2414, 0 10rpx 0 -4rpx #b48a44, 0 12rpx 0 -6rpx #3a2414, 0 12rpx 20rpx rgba(0, 0, 0, 0.5);
}
.deck.empty { opacity: 0.25; }
.deck.big { width: 244rpx; height: 340rpx; border-radius: 22rpx; }
.deck-art { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.deck-count {
  position: absolute;
  left: 50%;
  bottom: 12rpx;
  transform: translateX(-50%);
  min-width: 44rpx;
  height: 34rpx;
  line-height: 32rpx;
  padding: 0 8rpx;
  box-sizing: border-box;
  border-radius: 17rpx;
  text-align: center;
  font-size: 22rpx;
  color: #ffe1a0;
  background: rgba(20, 12, 6, 0.75);
  border: 1rpx solid rgba(226, 182, 90, 0.7);
}

/* ======================= 矿石库 ======================= */
.bank {
  display: flex;
  justify-content: space-around;
  align-items: flex-end;
  margin: 14rpx 0;
  padding: 16rpx 6rpx 12rpx;
  border-radius: 24rpx;
  background: linear-gradient(180deg, rgba(58, 36, 20, 0.75), rgba(30, 18, 10, 0.85));
  border: 2rpx solid rgba(180, 138, 68, 0.45);
  box-shadow: inset 0 2rpx 10rpx rgba(0, 0, 0, 0.5);
}
.token { position: relative; width: 92rpx; height: 92rpx; transition: transform 0.18s ease-out; }
.token .chip { width: 92rpx; height: 92rpx; filter: drop-shadow(0 6rpx 6rpx rgba(0, 0, 0, 0.45)); }
.token .count {
  position: absolute;
  right: -6rpx;
  bottom: -6rpx;
  min-width: 38rpx;
  height: 38rpx;
  line-height: 34rpx;
  padding: 0 8rpx;
  box-sizing: border-box;
  border-radius: 19rpx;
  text-align: center;
  font-size: 24rpx;
  color: #fff;
  background: #1e140e;
  border: 2rpx solid rgba(255, 255, 255, 0.6);
}
.token.picked { transform: translateY(-14rpx); }
.token.picked .chip { filter: drop-shadow(0 0 10rpx rgba(255, 227, 154, 0.95)) drop-shadow(0 14rpx 10rpx rgba(0, 0, 0, 0.45)); }
.token.out .chip { opacity: 0.22; filter: grayscale(1); }
.token.out .count { opacity: 0.5; }
.token.is-gold .count { background: #3a2600; border-color: #f5c84a; color: var(--gold-hi); }
.pick-badge {
  position: absolute;
  left: 50%;
  top: -22rpx;
  transform: translateX(-50%);
  height: 36rpx;
  line-height: 36rpx;
  padding: 0 12rpx;
  border-radius: 18rpx;
  font-size: 22rpx;
  color: #3a2600;
  background: linear-gradient(180deg, var(--gold-hi), var(--gold));
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.4);
}

/* ======================= 我 ======================= */
.me {
  padding: 16rpx 18rpx 14rpx;
  border-radius: 24rpx;
  background: linear-gradient(180deg, rgba(74, 50, 34, 0.9), rgba(38, 25, 18, 0.94));
  border: 2rpx solid rgba(180, 138, 68, 0.4);
  box-shadow: 0 10rpx 26rpx rgba(0, 0, 0, 0.45);
  transition: border-color 0.2s, box-shadow 0.2s;
}
.me.active { border-color: rgba(226, 182, 90, 0.75); box-shadow: 0 0 24rpx rgba(226, 182, 90, 0.2); }
.me.discarding { border-color: var(--danger); box-shadow: 0 0 24rpx rgba(239, 106, 92, 0.45); }

.me-head { display: flex; align-items: center; }
.me-id { display: flex; flex-direction: column; margin-left: 14rpx; min-width: 0; flex: 1; }
.me-name { font-size: 30rpx; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.me-sub { font-size: 22rpx; color: var(--muted); }
.me-sub.live { color: var(--gold); }

.meter { width: 180rpx; margin-right: 20rpx; }
.meter-bar { height: 10rpx; border-radius: 5rpx; background: rgba(0, 0, 0, 0.35); overflow: hidden; }
.meter-fill { height: 100%; border-radius: 5rpx; background: linear-gradient(90deg, #8a9a6a, #c8d4a0); transition: width 0.3s; }
.meter-fill.high { background: linear-gradient(90deg, #f0bd55, #ffe39a); }
.meter-fill.over { background: linear-gradient(90deg, #ef6a5c, #ff9d8f); }
.meter-text { display: block; margin-top: 6rpx; text-align: right; font-size: 20rpx; color: var(--muted); font-weight: 400; }

.me-cols, .pd-cols { display: flex; justify-content: space-between; margin-top: 14rpx; padding: 0 4rpx; }
.col { display: flex; flex-direction: column; align-items: center; width: 100rpx; }
.bonus-card {
  position: relative;
  box-sizing: border-box;
  width: 60rpx;
  height: 70rpx;
  border-radius: 10rpx;
  padding-bottom: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.7);
  box-shadow: 0 4rpx 0 -1rpx rgba(0, 0, 0, 0.25), 0 6rpx 10rpx rgba(0, 0, 0, 0.35);
}
.bonus-card.zero { opacity: 0.3; box-shadow: none; }
.bonus-card.wild {
  border: 2rpx dashed rgba(245, 200, 74, 0.45);
  background: rgba(245, 184, 10, 0.06);
  box-shadow: none;
  font-size: 20rpx;
  color: rgba(255, 227, 154, 0.75);
}
.my-token { position: relative; width: 70rpx; height: 70rpx; margin-top: -18rpx; transition: transform 0.15s; }
.my-chip { width: 70rpx; height: 70rpx; filter: drop-shadow(0 4rpx 4rpx rgba(0, 0, 0, 0.4)); }
.my-token .count {
  position: absolute;
  right: -8rpx;
  bottom: -4rpx;
  min-width: 34rpx;
  height: 34rpx;
  line-height: 30rpx;
  padding: 0 6rpx;
  box-sizing: border-box;
  border-radius: 17rpx;
  text-align: center;
  font-size: 22rpx;
  color: #fff;
  background: #1e140e;
  border: 2rpx solid rgba(255, 255, 255, 0.6);
}
.my-token.zero .my-chip { opacity: 0.18; filter: grayscale(1); }
.my-token.zero .count { opacity: 0.4; }
.my-token.can-discard { animation: wiggle 0.9s ease-in-out infinite; }
.my-token.can-discard .count { background: var(--danger); border-color: #fff; }
@keyframes wiggle { 0%, 100% { transform: rotate(0); } 25% { transform: rotate(-7deg); } 75% { transform: rotate(7deg); } }


.me-foot { display: flex; justify-content: space-between; align-items: flex-end; margin-top: 14rpx; padding-top: 14rpx; border-top: 1rpx solid var(--line); }
.res { display: flex; }
.res .slot, .res-empty, .res-back { margin-right: 12rpx; }
.res-back { width: 96rpx; height: 134rpx; border-radius: 12rpx; border: 3rpx solid #b48a44; box-sizing: border-box; }
.res-empty {
  box-sizing: border-box;
  width: 96rpx;
  height: 134rpx;
  border-radius: 12rpx;
  border: 2rpx dashed rgba(255, 255, 255, 0.13);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.22);
}
.my-nobles { display: flex; flex-wrap: wrap; justify-content: flex-end; max-width: 220rpx; }
.my-nobles .noble-wrap { margin: 0 0 8rpx 8rpx; }
.nobles-empty {
  box-sizing: border-box;
  width: 64rpx;
  height: 64rpx;
  line-height: 60rpx;
  border-radius: 10rpx;
  text-align: center;
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.22);
  border: 2rpx dashed rgba(255, 255, 255, 0.13);
}

.spacer { height: calc(160rpx + env(safe-area-inset-bottom)); }

/* ======================= 底部操作栏 ======================= */
.bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 5;
  display: flex;
  align-items: center;
  min-height: 124rpx;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: linear-gradient(180deg, rgba(42, 30, 24, 0.97), rgba(18, 12, 10, 0.99));
  border-top: 2rpx solid rgba(226, 182, 90, 0.35);
  box-shadow: 0 -10rpx 30rpx rgba(0, 0, 0, 0.45);
}
.bar .btn { flex-shrink: 0; margin-left: 16rpx; min-width: 150rpx; }
.bar-text { flex: 1; min-width: 0; display: flex; flex-direction: column; font-size: 26rpx; line-height: 1.4; }
.bar-text.warn { display: block; color: #ffb4aa; }
.bar-text .strong, .strong { font-weight: 700; color: var(--gold-hi); font-size: 30rpx; }
.bar-hint { font-size: 22rpx; color: var(--muted); }
.bar-text.waiting { flex-direction: row; align-items: center; color: var(--muted); }
.dots { display: flex; margin-left: 10rpx; }
.dot { width: 10rpx; height: 10rpx; margin: 0 4rpx; border-radius: 50%; background: var(--gold); animation: bounce 1s infinite ease-in-out; }
.dot:nth-child(2) { animation-delay: 0.15s; }
.dot:nth-child(3) { animation-delay: 0.3s; }
@keyframes bounce { 0%, 80%, 100% { transform: scale(0.5); opacity: 0.4; } 40% { transform: scale(1); opacity: 1; } }

/* ======================= 弹层 ======================= */
.mask.bottom { align-items: flex-end; }
.mask.solid { background: radial-gradient(ellipse at 50% 30%, #3a2a20, #0f0b0a 75%); }

.sheet {
  width: 100%;
  padding: 18rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  border-radius: 36rpx 36rpx 0 0;
  background: linear-gradient(180deg, #3a2a20, #1f1612);
  border-top: 2rpx solid rgba(226, 182, 90, 0.4);
  box-shadow: 0 -20rpx 50rpx rgba(0, 0, 0, 0.5);
  animation: rise-in 0.24s ease-out;
}
.grip { width: 72rpx; height: 8rpx; margin: 0 auto 24rpx; border-radius: 4rpx; background: rgba(255, 255, 255, 0.2); }
.sheet-main { display: flex; align-items: flex-start; }
.sheet-info { flex: 1; min-width: 0; margin-left: 28rpx; }
.sheet-title { font-size: 34rpx; font-weight: 700; color: var(--gold-hi); }
.sheet-desc { margin-top: 6rpx; font-size: 24rpx; color: var(--muted); }

.plan { margin-top: 20rpx; padding: 10rpx 12rpx; border-radius: 16rpx; background: rgba(0, 0, 0, 0.22); }
.plan-row { display: flex; align-items: center; height: 46rpx; }
.plan-row .c, .plan-cell { flex: 1; text-align: center; font-size: 26rpx; }
.plan-cell { display: flex; justify-content: center; }
.plan-row.head .c { font-size: 20rpx; color: var(--muted); font-weight: 400; }
.plan-row .dim { color: rgba(255, 255, 255, 0.22); }
.plan-row .gold { color: var(--gold-hi); }
.plan-row .bad { color: var(--danger); }
.pip-s {
  box-sizing: border-box;
  width: 36rpx;
  height: 36rpx;
  line-height: 32rpx;
  border-radius: 50%;
  text-align: center;
  font-size: 22rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.85);
}
.sheet-tip { margin-top: 16rpx; font-size: 26rpx; font-weight: 600; }
.sheet-tip.ok { color: var(--ok); }
.sheet-tip.bad { color: #ffb4aa; }
.sheet-note { margin-top: 8rpx; font-size: 22rpx; color: var(--muted); }
.sheet-btns { display: flex; margin-top: 32rpx; }
.sheet-btns .btn { flex: 1; height: 88rpx; margin-left: 18rpx; }
.sheet-btns .btn:first-child { margin-left: 0; flex: 0.7; }

.wide { display: flex; width: 100%; height: 88rpx; margin-top: 28rpx; }
.dialog-actions { display: flex; margin-top: 12rpx; }
.dialog-actions .btn { flex: 1; }
.dialog-actions .btn + .btn { margin-left: 16rpx; }

/* 对手详情 */
.pd-head { display: flex; align-items: center; }
.pd-id { flex: 1; min-width: 0; margin-left: 16rpx; display: flex; flex-direction: column; }
.pd-name { font-size: 32rpx; font-weight: 700; }
.pd-sub { font-size: 22rpx; color: var(--muted); margin-top: 4rpx; }
.pd-cols { margin-top: 28rpx; }
.pd-cols .col { width: 92rpx; }
.pd-row { display: flex; align-items: center; flex-wrap: wrap; margin-top: 28rpx; }
.pd-label { font-size: 22rpx; color: var(--muted); margin-right: 12rpx; }
.pd-label.gap { margin-left: 28rpx; }
.pd-back { width: 46rpx; height: 64rpx; margin-right: 8rpx; border-radius: 6rpx; }
.pd-row .noble-wrap { margin-right: 8rpx; }
.pd-none { font-size: 22rpx; color: rgba(255, 255, 255, 0.3); }

/* 交接 */
.handoff { width: 100%; padding: 0 70rpx; box-sizing: border-box; text-align: center; animation: pop-in 0.25s ease-out; }
.handoff-crown { width: 96rpx; height: 96rpx; }
.handoff-title { margin-top: 16rpx; font-size: 56rpx; font-weight: 800; color: var(--gold-hi); letter-spacing: 4rpx; }
.handoff-sub { margin: 18rpx 0 60rpx; color: var(--muted); }

/* 记录 */
.log-list { max-height: 760rpx; margin-top: 24rpx; }
.log-item { display: flex; padding: 14rpx 0; border-bottom: 1rpx solid var(--line); font-size: 26rpx; line-height: 1.5; }
.log-round {
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  margin-right: 16rpx;
  border-radius: 50%;
  text-align: center;
  font-size: 20rpx;
  color: var(--gold-hi);
  background: rgba(226, 182, 90, 0.12);
}
.log-text { flex: 1; }

/* 结算 */
.result { text-align: center; }
.result-crown { width: 110rpx; height: 110rpx; margin: -90rpx auto 8rpx; display: block; filter: drop-shadow(0 8rpx 12rpx rgba(0, 0, 0, 0.5)); }
.result-sub { color: var(--muted); margin: 8rpx 0 22rpx; font-size: 24rpx; }
.rank-row {
  display: flex;
  align-items: center;
  padding: 18rpx 20rpx;
  margin-top: 12rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid var(--line);
  text-align: left;
}
.rank-row.first { background: linear-gradient(90deg, rgba(226, 182, 90, 0.28), rgba(226, 182, 90, 0.06)); border-color: rgba(226, 182, 90, 0.7); }
.rank-place { width: 44rpx; font-size: 32rpx; color: var(--gold-hi); }
.rank-row .avatar { width: 48rpx; height: 48rpx; font-size: 24rpx; }
.rank-name { flex: 1; margin-left: 14rpx; font-size: 30rpx; font-weight: 600; }
.rank-stat { display: flex; flex-direction: column; align-items: flex-end; }
.rank-pts { font-size: 36rpx; color: var(--gold-hi); line-height: 1.1; }
.rank-detail { font-size: 20rpx; color: var(--muted); }

/* 语言切换 */
.lang-pill {
  flex-shrink: 0;
  margin-left: 12rpx;
  height: 38rpx;
  line-height: 36rpx;
  padding: 0 14rpx;
  border-radius: 19rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: var(--gold-hi);
  border: 1rpx solid rgba(226, 182, 90, 0.6);
  background: rgba(0, 0, 0, 0.25);
}
