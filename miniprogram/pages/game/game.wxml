<!-- 对局记录旁的小图标：矿石 / 卡色 / 卡背 / 皇冠 -->
<template name="logIcons">
  <view class="li-wrap">
    <block wx:for="{{icons}}" wx:key="key">
      <image wx:if="{{item.kind === 'ore'}}" class="li-ore" src="/assets/art/ores/{{item.color}}.png" mode="aspectFit" />
      <view wx:elif="{{item.kind === 'card'}}" class="li-card gem-bg-{{item.color}}"></view>
      <image wx:elif="{{item.kind === 'back'}}" class="li-back" src="/assets/art/backs/tier{{item.tier}}.jpg" mode="aspectFill" />
      <image wx:elif="{{item.kind === 'crown'}}" class="li-crown" src="/assets/crown.svg" mode="aspectFit" />
    </block>
  </view>
</template>

<image class="wall" src="/assets/art/wall.jpg" mode="aspectFill" />
<view wx:if="{{view}}" class="page">
  <!-- ============ 对手 ============ -->
  <view class="opps">
    <view wx:for="{{view.opponents}}" wx:key="index" class="opp {{item.isCurrent ? 'cur' : ''}}" hover-class="press" data-index="{{item.index}}" bindtap="onTapPlayer">
      <view class="opp-head">
        <view class="avatar av-{{item.hue}}">{{item.initial}}</view>
        <view class="opp-id">
          <text class="opp-name">{{item.name}}</text>
          <view wx:if="{{item.isCurrent}}" class="opp-live"><view class="live-dot"></view><text>{{item.sub}}</text></view>
          <view wx:else class="opp-meta">
            <image class="mi-back" src="/assets/art/backs/tier1.jpg" mode="aspectFill" />
            <text class="num">{{item.reservedCount}}</text>
            <view class="mi-coin"></view>
            <text class="num {{item.tokenTotal >= 9 ? 'warn' : ''}}">{{item.tokenTotal}}</text>
          </view>
        </view>
        <view class="score">
          <image class="crown" src="/assets/crown.svg" mode="aspectFit" />
          <text class="num">{{item.points}}</text>
        </view>
      </view>
      <view class="opp-gems">
        <view wx:for="{{item.cols}}" wx:for-item="c" wx:key="color" class="mini">
          <view class="mini-card num gem-text gem-bg-{{c.color}} {{c.bonus ? '' : 'zero'}}">{{c.bonus}}</view>
          <text class="mini-tok num {{c.tokens ? '' : 'zero'}}">{{c.tokens}}</text>
        </view>
        <view class="mini">
          <image class="mini-gold" src="/assets/art/ores/gold.png" mode="aspectFit" />
          <text class="mini-tok num {{item.gold ? '' : 'zero'}}">{{item.gold}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- ============ 最近动作 ============ -->
  <view class="ribbon" bindtap="onShowLog">
    <view class="round-pill num">{{view.roundLabel}}</view>
    <text wx:if="{{view.lastRound && view.phase !== 'over'}}" class="last-pill">{{t.lastRound}}</text>
    <view wx:for="{{[view.logKey]}}" wx:key="*this" class="ribbon-text flash">
      <template is="logIcons" data="{{icons: view.lastIcons}}" />
      <text class="ribbon-line">{{view.lastLog}}</text>
    </view>
    <text class="ribbon-more">{{t.logMore}}</text>
    <view class="lang-pill" catchtap="onToggleLang">{{t.language}}</view>
  </view>

  <!-- ============ 牌桌 ============ -->
  <view class="table">
    <image class="table-bg" src="/assets/art/table.jpg" mode="scaleToFill" />
    <view class="nobles">
      <view wx:for="{{view.nobles}}" wx:key="id" class="noble-wrap"><noble noble="{{item}}" /></view>
    </view>
    <view wx:for="{{view.tiers}}" wx:for-item="row" wx:key="tier" class="tier">
      <view class="deck {{row.deckCount ? '' : 'empty'}}" hover-class="press" data-tier="{{row.tier}}" bindtap="onTapDeck">
        <image class="deck-art" src="/assets/art/backs/tier{{row.tier}}.jpg" mode="scaleToFill" />
        <view class="deck-count num">{{row.deckCount}}</view>
      </view>
      <view wx:for="{{row.slots}}" wx:for-item="slot" wx:key="key" class="slot" hover-class="press" data-id="{{slot.card ? slot.card.id : ''}}" data-source="board" bindtap="onTapCard">
        <card card="{{slot.card}}" deal="{{true}}" highlight="{{view.myTurn && view.phase === 'play'}}" selected="{{sheet && slot.card && sheet.id === slot.card.id}}" />
      </view>
    </view>
  </view>

  <!-- ============ 矿石库 ============ -->
  <view class="bank">
    <view wx:for="{{view.bank}}" wx:key="color" hover-class="press" class="token {{item.picked ? 'picked' : ''}} {{item.count ? '' : 'out'}} {{item.color === 'gold' ? 'is-gold' : ''}}" data-color="{{item.color}}" bindtap="onTapBank">
      <image class="chip" src="/assets/art/coins/{{item.color}}.png" mode="aspectFit" />
      <view class="count num">{{item.count}}</view>
      <view wx:if="{{item.picked}}" class="pick-badge num">+{{item.picked}}</view>
    </view>
  </view>

  <!-- ============ 我 ============ -->
  <view class="me {{view.myTurn ? 'active' : ''}} {{view.myTurn && view.phase === 'discard' ? 'discarding' : ''}}">
    <view class="me-head">
      <view class="avatar big av-{{view.me.hue}}">{{view.me.initial}}</view>
      <view class="me-id">
        <text class="me-name">{{view.me.name}}</text>
        <text class="me-sub {{view.myTurn ? 'live' : ''}}">{{view.me.sub}}</text>
      </view>
      <view class="meter">
        <view class="meter-bar"><view class="meter-fill {{view.me.tokenTotal > 10 ? 'over' : (view.me.tokenTotal >= 8 ? 'high' : '')}}" style="width: {{view.me.tokenPct}}%"></view></view>
        <text class="meter-text num">{{view.me.holding}}</text>
      </view>
      <view class="score big">
        <image class="crown" src="/assets/crown.svg" mode="aspectFit" />
        <text class="num">{{view.me.points}}</text>
        <view wx:for="{{gain ? [gain.key] : []}}" wx:key="*this" class="gain num">+{{gain.n}}</view>
      </view>
    </view>

    <view class="me-cols">
      <view wx:for="{{view.me.slots}}" wx:key="color" class="col" data-color="{{item.color}}" bindtap="onTapMyToken">
        <view wx:if="{{item.bonus >= 0}}" class="bonus-card gem-bg-{{item.color}} {{item.bonus ? '' : 'zero'}}">
          <text class="num gem-text">{{item.bonus}}</text>
        </view>
        <view wx:else class="bonus-card wild"><text>{{t.wild}}</text></view>
        <view class="my-token {{item.n ? '' : 'zero'}} {{view.myTurn && view.phase === 'discard' && item.n ? 'can-discard' : ''}}">
          <image class="my-chip" src="/assets/art/coins/{{item.color}}.png" mode="aspectFit" />
          <view class="count num">{{item.n}}</view>
          <view wx:if="{{item.out}}" class="out-badge num">−{{item.out}}</view>
        </view>
      </view>
    </view>

    <view class="me-foot">
      <view class="res">
        <view wx:for="{{view.me.reserved}}" wx:key="id" class="slot" hover-class="press" data-id="{{item.id}}" data-source="reserved" bindtap="onTapCard">
          <card card="{{item}}" size="small" highlight="{{view.myTurn && view.phase === 'play'}}" />
        </view>
        <image wx:for="{{view.me.hiddenReserved}}" wx:key="key" class="res-back" src="/assets/art/backs/tier{{item.tier}}.jpg" mode="aspectFill" />
        <view wx:for="{{view.me.emptySlots}}" wx:key="*this" class="res-empty"><text>{{t.reserve}}</text></view>
      </view>
      <view class="my-nobles">
        <view wx:for="{{view.me.nobles}}" wx:key="id" class="noble-wrap"><noble noble="{{item}}" size="small" /></view>
        <view wx:if="{{!view.me.nobles.length}}" class="nobles-empty">{{t.nobles}}</view>
      </view>
    </view>
  </view>

  <view class="spacer"></view>
</view>

<!-- ============ 底部操作栏 ============ -->
<view wx:if="{{view}}" class="bar">
  <block wx:if="{{syncing}}">
    <view class="bar-text waiting">
      <text>{{t.sending}}</text>
      <view class="dots"><view class="dot"></view><view class="dot"></view><view class="dot"></view></view>
    </view>
  </block>
  <block wx:elif="{{view.phase === 'over'}}">
    <text class="bar-text">{{t.gameOver}}</text>
    <view class="btn primary" hover-class="btn-hover" bindtap="showResult">{{t.results}}</view>
  </block>
  <block wx:elif="{{!view.myTurn}}">
    <view class="bar-text waiting">
      <text>{{view.waitingLabel}}</text>
      <view class="dots"><view class="dot"></view><view class="dot"></view><view class="dot"></view></view>
    </view>
  </block>
  <block wx:elif="{{view.phase === 'discard'}}">
    <text class="bar-text warn">{{view.discardLabel}}</text>
    <view class="btn ghost" hover-class="btn-hover" bindtap="onClearDiscards">{{t.clear}}</view>
    <view class="btn primary {{view.discardReady ? '' : 'disabled'}}" hover-class="btn-hover" bindtap="onConfirmDiscard">{{t.returnOres}}</view>
  </block>
  <block wx:elif="{{pickEval.hint}}">
    <view class="bar-picks">
      <template is="logIcons" data="{{icons: pickEval.icons}}" />
      <view class="bar-text">
        <text>{{pickEval.hint}}</text>
        <text wx:if="{{pickEval.tip}}" class="bar-hint">{{pickEval.tip}}</text>
      </view>
    </view>
    <view class="btn ghost" hover-class="btn-hover" bindtap="onClearPicks">{{t.clear}}</view>
    <view class="btn primary {{pickEval.ok ? '' : 'disabled'}}" hover-class="btn-hover" bindtap="onConfirmTake">{{t.take}}</view>
  </block>
  <block wx:else>
    <view class="bar-text">
      <text class="strong">{{t.yourTurn}}</text>
      <text class="bar-hint">{{t.turnHint}}</text>
    </view>
    <view wx:if="{{view.canPass}}" class="btn" hover-class="btn-hover" bindtap="onPass">{{t.pass}}</view>
  </block>
</view>

<!-- ============ 卡牌 / 牌堆面板 ============ -->
<view wx:if="{{sheet}}" class="mask bottom" bindtap="onCloseSheet">
  <view class="sheet" catchtap="noop">
    <view class="grip"></view>
    <view class="sheet-main">
      <card wx:if="{{sheet.kind === 'card'}}" card="{{sheet.card}}" size="large" />
      <view wx:else class="deck big">
        <image class="deck-art" src="/assets/art/backs/tier{{sheet.tier}}.jpg" mode="scaleToFill" />
      </view>
      <view class="sheet-info">
        <view class="sheet-title">{{sheet.title}}</view>
        <view class="sheet-desc">{{sheet.desc}}</view>
        <view wx:if="{{sheet.plan}}" class="plan">
          <view class="plan-row head">
            <text class="c">{{t.colCost}}</text><text class="c">{{t.colBonus}}</text><text class="c">{{t.colHand}}</text><text class="c">{{t.colGold}}</text><text class="c">{{t.colShort}}</text>
          </view>
          <view wx:for="{{sheet.plan}}" wx:key="color" class="plan-row">
            <view class="plan-cell"><view class="pip-s num gem-text gem-bg-{{item.color}}">{{item.cost}}</view></view>
            <text class="c num {{item.byBonus ? '' : 'dim'}}">{{item.byBonus || '·'}}</text>
            <text class="c num {{item.byTokens ? '' : 'dim'}}">{{item.byTokens || '·'}}</text>
            <text class="c num {{item.byGold ? 'gold' : 'dim'}}">{{item.byGold || '·'}}</text>
            <text class="c num {{item.short ? 'bad' : 'dim'}}">{{item.short || '·'}}</text>
          </view>
        </view>
        <view wx:if="{{sheet.tip}}" class="sheet-tip {{sheet.ok ? 'ok' : 'bad'}}">{{sheet.tip}}</view>
        <view wx:if="{{sheet.showReserve}}" class="sheet-note">{{sheet.note}}</view>
      </view>
    </view>
    <view class="sheet-btns">
      <view class="btn ghost" hover-class="btn-hover" bindtap="onCloseSheet">{{sheet.showBuy || sheet.showReserve ? t.cancel : t.close}}</view>
      <view wx:if="{{sheet.showReserve}}" class="btn {{sheet.kind === 'deck' ? 'primary' : ''}} {{sheet.canReserve ? '' : 'disabled'}}" hover-class="btn-hover" bindtap="onSheetReserve">{{t.reserve}}</view>
      <view wx:if="{{sheet.showBuy}}" class="btn primary {{sheet.canBuy ? '' : 'disabled'}}" hover-class="btn-hover" bindtap="onSheetBuy">{{t.buy}}</view>
    </view>
  </view>
</view>

<!-- ============ 对手详情 ============ -->
<view wx:if="{{playerSheet}}" class="mask" bindtap="onClosePlayer">
  <view class="dialog player-dialog" catchtap="noop">
    <view class="pd-head">
      <view class="avatar big av-{{playerSheet.hue}}">{{playerSheet.initial}}</view>
      <view class="pd-id">
        <text class="pd-name">{{playerSheet.name}}</text>
        <text class="pd-sub">{{playerSheet.sub}}</text>
      </view>
      <view class="score big">
        <image class="crown" src="/assets/crown.svg" mode="aspectFit" />
        <text class="num">{{playerSheet.points}}</text>
      </view>
    </view>
    <view class="pd-cols">
      <view wx:for="{{playerSheet.cols}}" wx:key="color" class="col">
        <view class="bonus-card gem-bg-{{item.color}} {{item.bonus ? '' : 'zero'}}"><text class="num gem-text">{{item.bonus}}</text></view>
        <view class="my-token {{item.tokens ? '' : 'zero'}}">
          <image class="my-chip" src="/assets/art/coins/{{item.color}}.png" mode="aspectFit" />
          <view class="count num">{{item.tokens}}</view>
        </view>
      </view>
      <view class="col">
        <view class="bonus-card wild"><text>{{t.wild}}</text></view>
        <view class="my-token {{playerSheet.gold ? '' : 'zero'}}">
          <image class="my-chip" src="/assets/art/coins/gold.png" mode="aspectFit" />
          <view class="count num">{{playerSheet.gold}}</view>
        </view>
      </view>
    </view>
    <view class="pd-sections">
      <view class="pd-sec">
        <text class="pd-label">{{t.reserve}} · {{playerSheet.reservedCount}}</text>
        <view class="pd-items">
          <image wx:for="{{playerSheet.reservedTiers}}" wx:key="key" class="pd-back" src="/assets/art/backs/tier{{item.tier}}.jpg" mode="scaleToFill" />
          <text wx:if="{{!playerSheet.reservedCount}}" class="pd-none">{{t.none}}</text>
        </view>
      </view>
      <view class="pd-sec">
        <text class="pd-label">{{t.nobles}} · {{playerSheet.nobleCount}}</text>
        <view class="pd-items">
          <view wx:for="{{playerSheet.nobles}}" wx:key="id" class="noble-wrap"><noble noble="{{item}}" size="small" /></view>
          <text wx:if="{{!playerSheet.nobleCount}}" class="pd-none">{{t.none}}</text>
        </view>
      </view>
    </view>
    <view class="btn wide" hover-class="btn-hover" bindtap="onClosePlayer">{{t.close}}</view>
  </view>
</view>

<!-- ============ 贵族来访 ============ -->
<view wx:if="{{celebrate}}" class="celebrate" bindtap="onCloseCelebrate">
  <view class="celebrate-card">
    <view class="celebrate-rays"></view>
    <view class="celebrate-noble"><noble noble="{{celebrate.noble}}" size="large" /></view>
    <view class="celebrate-text">{{celebrate.text}}</view>
    <view class="celebrate-pts num">+{{celebrate.points}}</view>
  </view>
</view>

<!-- ============ 同屏多人：交接手机 ============ -->
<view wx:if="{{handoff}}" class="mask solid">
  <view class="handoff">
    <view class="avatar huge av-{{handoff.hue}}">{{handoff.initial}}</view>
    <view class="handoff-title">{{handoff.title}}</view>
    <view class="handoff-sub">{{handoff.sub}}</view>
    <view class="btn primary wide" hover-class="btn-hover" bindtap="onHandoffReady">{{handoff.btn}}</view>
  </view>
</view>

<!-- ============ 对局记录 ============ -->
<view wx:if="{{showLog}}" class="mask" bindtap="onCloseLog">
  <view class="dialog" catchtap="noop">
    <view class="dialog-title">{{t.logTitle}}</view>
    <scroll-view scroll-y class="log-list">
      <view wx:for="{{logs}}" wx:key="key" class="log-item">
        <text class="log-round num">{{item.round}}</text>
        <text class="log-text">{{item.text}}</text>
        <template is="logIcons" data="{{icons: item.icons}}" />
      </view>
    </scroll-view>
    <view class="btn wide" hover-class="btn-hover" bindtap="onCloseLog">{{t.close}}</view>
  </view>
</view>

<!-- ============ 结算 ============ -->
<view wx:if="{{result}}" class="mask">
  <view class="dialog result">
    <image class="result-crown" src="/assets/crown.svg" mode="aspectFit" />
    <view class="dialog-title">{{result.title}}</view>
    <view class="result-sub">{{result.sub}}</view>
    <view wx:for="{{result.rank}}" wx:key="name" class="rank-row {{index === 0 ? 'first' : ''}}">
      <text class="rank-place num">{{item.place}}</text>
      <view class="avatar av-{{item.hue}}">{{item.initial}}</view>
      <text class="rank-name">{{item.name}}</text>
      <view class="rank-stat">
        <text class="rank-pts num">{{item.points}}</text>
        <text class="rank-detail">{{item.detail}}</text>
      </view>
    </view>
    <view wx:if="{{result.canRematch}}" class="btn primary wide" hover-class="btn-hover" bindtap="onRematch">{{t.rematch}}</view>
    <view wx:else class="wait-rematch">{{t.waitRematch}}</view>
    <view class="dialog-actions">
      <view class="btn ghost" hover-class="btn-hover" bindtap="onCloseResult">{{t.viewTable}}</view>
      <view class="btn ghost" hover-class="btn-hover" bindtap="onHome">{{t.home}}</view>
    </view>
  </view>
</view>
