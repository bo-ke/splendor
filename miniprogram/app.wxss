/* 全局主题 */
page {
  --bg: #1f2a44;
  --panel: #2b3a5c;
  --panel-2: #34466e;
  --text: #f3f1ea;
  --muted: #a9b3c9;
  --accent: #f2c14e;
  --danger: #e2574c;

  --gem-white: #f5f5f0;
  --gem-blue: #2f6fd6;
  --gem-green: #2e9e5b;
  --gem-red: #d63a3a;
  --gem-black: #3b3133;
  --gem-gold: #e8b923;

  background: var(--bg);
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  font-size: 28rpx;
}

/* 宝石颜色（背景） */
.bg-white { background: var(--gem-white); color: #333; }
.bg-blue { background: var(--gem-blue); color: #fff; }
.bg-green { background: var(--gem-green); color: #fff; }
.bg-red { background: var(--gem-red); color: #fff; }
.bg-black { background: var(--gem-black); color: #fff; }
.bg-gold { background: var(--gem-gold); color: #3a2a00; }

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 76rpx;
  padding: 0 36rpx;
  border-radius: 38rpx;
  font-size: 28rpx;
  font-weight: 600;
  background: var(--panel-2);
  color: var(--text);
}
.btn.primary { background: var(--accent); color: #2a2000; }
.btn.danger { background: var(--danger); color: #fff; }
.btn.disabled { opacity: 0.4; }
.btn-hover { opacity: 0.75; }
