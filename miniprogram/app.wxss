/* ================= 全局主题：胡桃木、羊皮纸与烫金 ================= */
page {
  --bg-top: #2a1e18;
  --bg: #1b1412;
  --bg-deep: #0f0b0a;
  --panel: rgba(255, 236, 200, 0.06);
  --panel-solid: #2e221b;
  --panel-2: #3e2d22;
  --line: rgba(255, 226, 180, 0.13);
  --text: #f3e7cf;
  --muted: #b5a184;
  --gold: #e2b65a;
  --gold-hi: #ffe1a0;
  --gold-lo: #9c6a1c;
  --parchment: #efe0bf;
  --ink: #3a2414;
  --danger: #ef6a5c;
  --ok: #6fe39a;

  min-height: 100%;
  background: radial-gradient(ellipse 120% 70% at 50% 0%, #3a2a20 0%, var(--bg) 55%, var(--bg-deep) 100%);
  background-color: var(--bg);
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
}

/* 数字用衬线体，更有桌游质感 */
.num { font-family: Georgia, 'Times New Roman', 'Songti SC', serif; font-weight: 700; }

/* 宝石色渐变（成本圆点、加成小卡、贵族要求等共用） */
.gem-bg-white { background: radial-gradient(circle at 32% 28%, #ffffff 0%, #dfe6ef 50%, #8e9bb0 100%); color: #263043; }
.gem-bg-blue { background: radial-gradient(circle at 32% 28%, #9cc0ff 0%, #2f6fe0 50%, #0f3378 100%); color: #fff; }
.gem-bg-green { background: radial-gradient(circle at 32% 28%, #9af0bf 0%, #1fa463 50%, #0a4f2d 100%); color: #fff; }
.gem-bg-red { background: radial-gradient(circle at 32% 28%, #ffa3ae 0%, #e0263f 50%, #6e0b19 100%); color: #fff; }
.gem-bg-black { background: radial-gradient(circle at 32% 28%, #a596b3 0%, #4b4253 50%, #120e16 100%); color: #fff; }
.gem-bg-gold { background: radial-gradient(circle at 32% 28%, #fff1b8 0%, #f5b80a 50%, #7a4f00 100%); color: #3a2600; }
.gem-text { text-shadow: 0 1rpx 3rpx rgba(0, 0, 0, 0.75); }
.gem-bg-white.gem-text, .gem-bg-gold.gem-text { text-shadow: 0 1rpx 0 rgba(255, 255, 255, 0.7); }

/* 按钮 */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  height: 80rpx;
  padding: 0 36rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  color: var(--text);
  background: linear-gradient(180deg, #5a3e2a, #3a2618);
  border: 1rpx solid rgba(255, 220, 160, 0.22);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.15), 0 4rpx 10rpx rgba(0, 0, 0, 0.3);
}
.btn.primary {
  color: #3a2600;
  background: linear-gradient(180deg, var(--gold-hi), var(--gold) 45%, #d99a2b);
  border-color: rgba(255, 240, 200, 0.6);
  box-shadow: inset 0 2rpx 0 rgba(255, 255, 255, 0.6), 0 6rpx 16rpx rgba(242, 195, 91, 0.35);
}
.btn.ghost { background: transparent; box-shadow: none; }
.btn.disabled { opacity: 0.38; box-shadow: none; }
.btn-hover { transform: scale(0.97); opacity: 0.85; }
/* 卡牌、矿石等可点元素的按下反馈 */
.press { transform: scale(0.95); opacity: 0.88; transition: transform 0.08s; }

/* 头像 */
.avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  font-size: 26rpx;
  font-weight: 700;
  color: #fff;
  border: 2rpx solid rgba(255, 255, 255, 0.5);
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.4);
}
.av-0 { background: linear-gradient(135deg, #f0bd55, #b9781a); }
.av-1 { background: linear-gradient(135deg, #6fa2f5, #2a56b8); }
.av-2 { background: linear-gradient(135deg, #5fd093, #1d7a48); }
.av-3 { background: linear-gradient(135deg, #f07b8c, #a8293d); }

/* 弹层 */
.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(10, 6, 4, 0.7);
  animation: fade-in 0.18s ease-out;
}
@keyframes fade-in { from { opacity: 0; } to { opacity: 1; } }
@keyframes rise-in { from { transform: translateY(60rpx); opacity: 0; } to { transform: none; opacity: 1; } }
@keyframes pop-in { from { transform: scale(0.9); opacity: 0; } to { transform: none; opacity: 1; } }

.dialog {
  width: 660rpx;
  padding: 40rpx 36rpx 36rpx;
  box-sizing: border-box;
  border-radius: 28rpx;
  background: linear-gradient(180deg, #3a2a20, #221813);
  border: 2rpx solid rgba(226, 182, 90, 0.5);
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.5);
  animation: pop-in 0.22s ease-out;
}
.dialog-title { font-size: 36rpx; font-weight: 700; text-align: center; color: var(--gold-hi); letter-spacing: 4rpx; }

/* 墙纸背景（WXSS 的 background-image 不能用本地图片，所以用 <image> 铺底） */
.wall { position: fixed; left: 0; top: 0; width: 100%; height: 100%; z-index: 0; }
.page { position: relative; z-index: 1; }
